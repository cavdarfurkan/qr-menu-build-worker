# Redis Configuration
REDIS_ADDR=your-redis-endpoint.cache.amazonaws.com:6379
QUEUE_KEY=queue:build:main

# AWS Configuration (provided by IAM role on EC2)
AWS_DEFAULT_REGION=eu-central-1

# Cloudflare Configuration
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Container Images (from ECR)
BUILDER_IMAGE=123456789012.dkr.ecr.eu-central-1.amazonaws.com/astro-builder:latest
UNPUBLISH_IMAGE=123456789012.dkr.ecr.eu-central-1.amazonaws.com/unpublish-image:latest
