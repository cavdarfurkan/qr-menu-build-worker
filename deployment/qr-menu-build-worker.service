[Unit]
Description=QR Menu Build Worker
Documentation=https://github.com/cavdarfurkan/qr-menu-build-worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
EnvironmentFile=/etc/qr-menu-worker.env
ExecStart=/usr/local/bin/qr-menu-build-worker
Restart=always
RestartSec=10
StartLimitInterval=0

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qr-menu-build-worker

[Install]
WantedBy=multi-user.target
